# Set ONE of the following. Groq and OpenRouter both have free tiers.

# Free tier, fast. Get a key at https://console.groq.com
GROQ_API_KEY=

# Free models available. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Requires paid credit. Get a key at https://platform.openai.com
OPENAI_API_KEY=

# Optional. Overrides the default model for whichever provider is used.
MODEL=
